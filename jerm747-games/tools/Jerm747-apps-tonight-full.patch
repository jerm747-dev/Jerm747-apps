+  owned: new Set(store.get('owned', ['ember'])),
+  trailId: store.get('trail', 'ember'),
+  get trail() { return ITEMS.find(i => i.id === this.trailId)?.color; },
+  get magnet() { return this.owned.has('charm') ? 1.6 : .85; },
+  get speed() { return this.owned.has('tabi') ? 1.08 : 1; },
+  addSilver(n) { this.wallet += n; store.set('wallet', this.wallet); paintWallet(); },
+  onTrailWin(time, best, silver) {
+    showReward({kicker:'Golden Ridge', title:'Trail cleared', line:'The forest is behind you. The mountain is next.',
+      stats:[['Time', clock(time)], ['Best', clock(best)], ['Silver', '◈ ' + silver, true]],
+      actions:[['Climb the mountain', () => { closeAll(); switchStage(); }, true], ['Run it again', () => { closeAll(); reset(); }], ['Title', () => { closeAll(); openTitle(); }]]});
+  },
+  onSummit(time) {
+    showReward({kicker:'Windbreak summit', title:'Windcleaver', line:'The summit blade is yours. Every swing now reaches farther.',
+      stats:[['Climb', clock(time)], ['Carrying', '◈ ' + this.wallet, true]], glyph:true,
+      actions:[['Keep the blade', () => closeAll(), true], ['Back to the trail', () => { closeAll(); switchStage(); }], ['Title', () => { closeAll(); openTitle(); }]]});
+  }
+};
+function toast(text) { const t = q('#toast'); t.textContent = text; t.classList.add('show'); clearTimeout(toast.h); toast.h = setTimeout(() => t.classList.remove('show'), 1800); }
+function paintWallet() { for (const id of ['#tWallet', '#pWallet', '#sWallet']) { const el = q(id); if (el) el.textContent = id === '#pWallet' ? RL.wallet + ' silver' : RL.wallet; } paintFoot(); }
+function paintFoot() {
+  const b = (() => { try { return Number(localStorage.getItem('shadow-best-run')) || 0; } catch { return 0; } })();
+  const blade = (() => { try { return localStorage.getItem('shadow-summit-blade') === '1'; } catch { return false; } })();
+  q('#tFoot').innerHTML = (b ? 'Best trail <b>' + clock(b) + '</b> · ' : '') + '<b>◈ ' + RL.wallet + '</b> silver' + (blade ? ' · <b>Windcleaver</b> claimed' : '');
+}
+/* ----- Silver Shrine ----- */
+function paintShop() {
+  const list = q('#shopList'); list.innerHTML = '';
+  for (const it of ITEMS) {
+    const owned = RL.owned.has(it.id), equipped = it.kind === 'trail' && RL.trailId === it.id;
+    const row = document.createElement('div'); row.className = 'item' + (owned ? ' owned' : '');
+    row.innerHTML = '<i>' + it.icon + '</i><div><b>' + it.name + '</b><small>' + it.note + '</small></div>';
+    const btn = document.createElement('button');
+    if (!owned) { btn.textContent = '◈ ' + it.cost; btn.disabled = RL.wallet < it.cost; btn.onclick = () => buy(it); }
+    else if (it.kind === 'trail') { btn.textContent = equipped ? 'Equipped' : 'Equip'; btn.disabled = equipped; btn.onclick = () => { RL.trailId = it.id; store.set('trail', it.id); paintShop(); toast(it.name + ' equipped'); }; }
+    else { btn.textContent = 'Owned'; btn.disabled = true; }
+    row.append(btn); list.append(row);
+  }
+  paintWallet();
+}
+function buy(it) {
+  if (RL.wallet < it.cost) return;
+  RL.wallet -= it.cost; store.set('wallet', RL.wallet);
+  RL.owned.add(it.id); store.set('owned', [...RL.owned]);
+  if (it.kind === 'trail') { RL.trailId = it.id; store.set('trail', it.id); }
+  paintShop(); toast(it.name + ' — yours');
+}
+function openShop() { held.clear(); clearStick(); paintShop(); q('#shopMenu').showModal(); q('#shopMenu button:not([disabled])')?.focus(); }
+q('#sClose').onclick = () => q('#shopMenu').close();
+/* ----- Reward card ----- */
+function showReward({kicker, title, line, stats, actions, glyph}) {
+  held.clear(); clearStick();
+  const d = q('#reward');
+  q('#rKicker').textContent = kicker; q('#rTitle').textContent = title; q('#rLine').textContent = line;
+  d.querySelector('.glyph').style.display = glyph ? '' : 'none';
+  q('#rStats').innerHTML = stats.map(([k, v, g]) => '<div class="' + (g ? 'gold' : '') + '">' + k + '<b>' + v + '</b></div>').join('');
+  const box = q('#rActions'); box.innerHTML = '';
+  for (const [label, fn, primary] of actions) { const b = document.createElement('button'); b.textContent = label; if (primary) b.className = 'primary'; b.onclick = fn; box.append(b); }
+  setTimeout(() => { if (!d.open) d.showModal(); box.querySelector('button')?.focus(); }, 650);
+}
+function closeAll() { for (const d of document.querySelectorAll('dialog[open]')) d.close(); }
+/* ----- Pause menu ----- */
+const pause = q('#pauseMenu');
+function openPause() {
+  if (!titleScreen.hidden || document.querySelector('dialog[open]')) return;
+  held.clear(); clearStick();
+  q('#pauseTitle').textContent = ascent ? 'Windbreak Mountain' : regions[regionAt(player.z)].name;
+  q('#pRoute').firstChild.textContent = ascent ? 'Forest trail ' : 'Mountain ascent ';
+  q('#pRestartSub').textContent = ascent ? 'from the last checkpoint' : 'from the trailhead';
+  paintWallet(); pause.showModal(); q('#pResume').focus();
+}
+q('#pResume').onclick = () => pause.close();
+q('#pRestart').onclick = () => { pause.close(); q('#reset').click(); };
+q('#pRoute').onclick = () => { pause.close(); switchStage(); };
+q('#pShop').onclick = () => { pause.close(); openShop(); };
+q('#pHelp').onclick = () => { pause.close(); guide.showModal(); };
+q('#pFull').onclick = () => toggleFull();
+q('#pTitle').onclick = () => { pause.close(); openTitle(); };
+q('#menuBtn').onclick = () => openPause();
+q('#startBtn').onclick = () => openPause();
+q('#selectBtn').onclick = () => { if (titleScreen.hidden) openShop(); };
+q('#t-shop').onclick = () => openShop();
+q('#t-help').onclick = () => guide.showModal();
+q('#t-full').onclick = () => toggleFull();
+/* ----- Full screen ----- */
+function toggleFull() {
+  const d = document;
+  try {
+    if (d.fullscreenElement || d.webkitFullscreenElement) (d.exitFullscreen || d.webkitExitFullscreen).call(d);
+    else { const el = d.documentElement; const r = (el.requestFullscreen || el.webkitRequestFullscreen)?.call(el, {navigationUI: 'hide'}); r?.then?.(() => screen.orientation?.lock?.('landscape').catch(() => {})).catch(() => {}); }
+  } catch {}
+}
+q('#fullBtn').onclick = () => toggleFull();
+document.addEventListener('fullscreenchange', () => document.documentElement.classList.toggle('immersive', !!document.fullscreenElement));
+/* ----- Keyboard ----- */
+window.addEventListener('keydown', e => {
+  if (e.code === 'Escape' && titleScreen.hidden && !document.querySelector('dialog[open]')) { e.preventDefault(); openPause(); }
+  if (e.code === 'Tab' && titleScreen.hidden && !document.querySelector('dialog[open]')) { e.preventDefault(); openShop(); }
+  if (e.code === 'KeyF' && !e.repeat && !document.querySelector('dialog[open]')) toggleFull();
+}, true);
+/* ----- Controller in menus: D-pad moves, A picks, B backs out; Start = menu, Select = shrine ----- */
+let last = [];
+function focusables(root) { return [...root.querySelectorAll('button:not([disabled])')].filter(b => b.offsetParent !== null); }
+function step(root, dir) {
+  const list = focusables(root); if (!list.length) return;
+  const i = list.indexOf(document.activeElement);
+  list[(i + dir + list.length) % list.length].focus();
+}
+function poll() {
+  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean);
+  if (pad) {
+    const p = i => Boolean(pad.buttons[i]?.pressed), edge = i => p(i) && !last[i];
+    const open = document.querySelector('dialog[open]');
+    const ax = pad.axes[1] || 0;
+    if (open) {
+      if (edge(12) || (ax < -.6 && !last.up)) step(open, -1);
+      if (edge(13) || (ax > .6 && !last.down)) step(open, 1);
+      if (edge(0)) { (document.activeElement && open.contains(document.activeElement) ? document.activeElement : focusables(open)[0])?.click(); gamepadButtons[0] = true; }
+      if (edge(1) || (edge(9) && open === pause)) { open.close(); gamepadButtons[1] = true; }
+    } else if (titleScreen.hidden) {
+      if (edge(9)) openPause();
+      if (edge(8)) openShop();
+    } else {
+      if (edge(9)) q('#play-trail').click();
+    }
+    last = pad.buttons.map(b => b.pressed); last.up = ax < -.6; last.down = ax > .6;
+  }
+  requestAnimationFrame(poll);
+}
+requestAnimationFrame(poll);
+/* ----- Atmosphere: drifting red leaves over the scene ----- */
+const drift = Array.from({length: 18}, (_, i) => ({x: Math.random(), y: Math.random(), s: .5 + Math.random(), r: Math.random() * 6, v: .03 + Math.random() * .05, w: Math.random() * 6}));
+const leafPath = new Path2D('M0-6 1.2-2.6 4-4.2 3.2-.8 6.6-1.3 4.6 1.4 7.4 2.9 4 3.8 5 6.9 2 5.5 0 9-2 5.5-5 6.9-4 3.8-7.4 2.9-4.6 1.4-6.6-1.3-3.2-.8-4-4.2-1.2-2.6z');
+const baseRender = render;
+let lastT = performance.now();
+render = function () {
+  baseRender();
+  if (!W || !H) return;
+  const now = performance.now(), dt = Math.min(.05, (now - lastT) / 1000); lastT = now;
+  ctx.save();
+  for (const l of drift) {
+    l.y += l.v * dt * (ascent ? .6 : 1); l.x += Math.sin(now / 900 + l.w) * .0006 + .0004; l.r += dt * (1 + l.s);
+    if (l.y > 1.05) { l.y = -.05; l.x = Math.random(); }
+    if (l.x > 1.05) l.x = -.05;
+    ctx.setTransform(1, 0, 0, 1, 0, 0);
+    const dpr = canvas.width / W;
+    ctx.translate(l.x * W * dpr, l.y * H * dpr); ctx.rotate(l.r); ctx.scale(l.s * dpr * .9, l.s * dpr * .9 * (.6 + .4 * Math.abs(Math.sin(l.r))));
+    ctx.globalAlpha = .55; ctx.fillStyle = l.s > 1.1 ? '#c8202c' : '#8f1a22'; ctx.fill(leafPath);
+  }
+  ctx.restore();
+  const dpr = canvas.width / W; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+};
+/* ----- Title focus cycling (replaces the two-button version) ----- */
+titleScreen.addEventListener('keydown', e => {
+  if (!['ArrowUp', 'ArrowDown'].includes(e.key)) return;
+  e.preventDefault(); e.stopImmediatePropagation(); step(q('.title-actions'), e.key === 'ArrowUp' ? -1 : 1);
+}, true);
+paintWallet();
+})();
+
+</script>
+</body></html>
