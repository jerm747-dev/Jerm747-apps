@@ -2,8 +2,10 @@
 set -euo pipefail
 cd "$(dirname "$0")"
 : "${ANDROID_HOME:?Set ANDROID_HOME to the Android SDK path}"
-: "${PATCH_BAY_KEYSTORE:?Set PATCH_BAY_KEYSTORE to your signing key path}"
