 if [[ -n "${PATCH_BAY_KEY_PASS:-}" ]]; then signing_options+=(--ks-pass env:PATCH_BAY_KEY_PASS); fi
-"$tools/apksigner" sign --ks "$PATCH_BAY_KEYSTORE" --ks-key-alias "$PATCH_BAY_KEY_ALIAS" "${signing_options[@]}" --out build/PatchBay-0.1.0.apk build/aligned.apk
-"$tools/apksigner" verify --verbose build/PatchBay-0.1.0.apk
