<resources>
    <!-- Android 12+: the system splash shows the boombox, then the app's own splash shows the full Jerm747 Beat Room logo -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/room_bg</item>
        <item name="android:windowSplashScreenBackground">@color/room_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/room_bg</item>
        <item name="android:statusBarColor">@color/room_bg</item>
        <item name="android:navigationBarColor">@color/room_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
